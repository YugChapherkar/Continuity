# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Required HMAC-SHA256 secret key (minimum 32 characters).
# Must be set in production and match across Next.js and backend microservices.
JWT_SECRET="continuity-enterprise-secret-key-2026-secure-hmac-sha256"

# DATABASE_URL: Prisma database connection string
DATABASE_URL="file:./continuity.db"

# NEXT_PUBLIC_DEMO_MODE: Enable 1-click test credentials autofill on login page
NEXT_PUBLIC_DEMO_MODE=true
